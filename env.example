# Pflicht
SECRET_KEY=change-me-to-a-random-secret
ADMIN_PASSWORD_ADMIN=change-me
ADMIN_PASSWORD_DANIEL=change-me

# Logging (optional): INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# Optional weitere Admin-Accounts (werden beim ersten Start angelegt, falls gesetzt)
ADMIN_PASSWORD_COSME=
ADMIN_PASSWORD_SASCHA=
ADMIN_PASSWORD_PATRICK=

# Telegram-Benachrichtigung bei Gast-Anmeldung (kein TPCG-Mitglied)
TELEGRAM_BOT_TOKEN=
# Kommagetrennte Liste von Telegram Chat-IDs der Admins, die benachrichtigt werden sollen
ADMIN_TELEGRAM_IDS=

# Telegram-Bot (optional)
# Geheimer Code, mit dem sich zusaetzliche Admins im Bot verifizieren koennen.
# Ist nicht gesetzt, koennen nur die User aus ADMIN_TELEGRAM_IDS Admin-Aktionen nutzen.
TELEGRAM_ADMIN_VERIFY_CODE=
