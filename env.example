# Pflicht
SECRET_KEY=change-me-to-a-random-secret
ADMIN_PASSWORD_ADMIN=change-me
ADMIN_PASSWORD_DANIEL=change-me

# Logging (optional): INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO

# Optional weitere Admin-Accounts (werden beim ersten Start angelegt, falls gesetzt)
ADMIN_PASSWORD_COSME=
ADMIN_PASSWORD_SASCHA=
ADMIN_PASSWORD_PATRICK=
ADMIN_PASSWORD_DOMINIK=

# Telegram-Benachrichtigung bei Gast-Anmeldung (kein TPCG-Mitglied)
TELEGRAM_BOT_TOKEN=
# Kommagetrennte Liste von Telegram Chat-IDs der Admins, die benachrichtigt werden sollen
ADMIN_TELEGRAM_IDS=

# Telegram-Bot (optional)
# Geheimer Code, mit dem sich zusaetzliche Admins im Bot verifizieren koennen.
# Ist nicht gesetzt, koennen nur die User aus ADMIN_TELEGRAM_IDS Admin-Aktionen nutzen.
TELEGRAM_ADMIN_VERIFY_CODE=

# Loesch-PIN (optional, Standardwerte in Klammern)
# Max. Fehlversuche bevor der PIN pro Eintrag+IP gesperrt wird (3)
DELETE_PIN_MAX_FAILED_ATTEMPTS=3
# Sperrdauer in Minuten nach Fehlversuchen (15)
DELETE_PIN_LOCK_MINUTES=15
# Max. Loeschversuche pro IP im Zeitfenster (10)
DELETE_PIN_IP_WINDOW_ATTEMPTS=10
# Zeitfenster in Minuten fuer das IP-Rate-Limiting (15)
DELETE_PIN_IP_WINDOW_MINUTES=15
# Peppersalt fuer die IP-Hashes (fester geheimer Wert verwenden)
DELETE_PIN_CLIENT_SALT=change-me-to-a-random-secret
